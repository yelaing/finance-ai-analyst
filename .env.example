# ---- 运行环境 ----
# dev : 日志输出 text、uvicorn 开启热重载、CORS 允许任意来源
# prod: 日志输出 json、关闭热重载、CORS 需显式指定
ENV=dev
LOG_LEVEL=INFO
# 留空则按 ENV 推导（dev=text, prod=json）；也可强制指定 text / json
# LOG_FORMAT=text

# ---- LLM 配置（任何 OpenAI 兼容的 API 均可）----
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=sk-your-api-key
LLM_MODEL=gpt-4o

# 向量化模型（历史报告语义检索用），需与 LLM_BASE_URL 属同一家服务
EMBEDDING_MODEL=text-embedding-v3

# ---- 数据源代理（可选）----
# 美股走 yfinance，国内网络通常需要代理；容器内请留空
# HTTP_PROXY=http://127.0.0.1:7897

# ---- ChromaDB 持久化目录 ----
CHROMA_PERSIST_DIR=./data/chroma

# ---- 后端服务 ----
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
# JSON 数组格式。prod 环境不要用 ["*"]，否则启动时会打 WARNING
# CORS_ORIGINS=["http://localhost:8501"]

# ---- 缓存（进程内 TTL + LRU）----
# 关掉后行为退化成与没有缓存时完全一致
CACHE_ENABLED=true
CACHE_MAXSIZE=512
# 数据源结果 TTL（秒）：短 TTL 保新鲜度
CACHE_TTL_SECONDS=1800
# LLM / embedding TTL（秒）：长 TTL 做确定性记忆化，同输入不重复付费
CACHE_LLM_TTL_SECONDS=86400

# ---- LLM 成本换算（可选）----
# 留空则只统计 token 数量，不换算金额 —— 各提供方价格变动频繁，
# 代码里硬编码一张价目表等于编造事实。要用就按你实际签约的单价填。
# LLM_PRICE_INPUT_PER_1K=
# LLM_PRICE_OUTPUT_PER_1K=
